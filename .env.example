# Salin file ini menjadi .env.local lalu sesuaikan nilainya
# Koneksi MongoDB (lokal). Untuk Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pos-umkm
MONGODB_URI=mongodb://127.0.0.1:27017/pos-umkm

# Secret untuk menandatangani token JWT login
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-yang-panjang

# Identitas perusahaan untuk kop Surat Jalan
NEXT_PUBLIC_COMPANY_NAME="Nama Distributor"
NEXT_PUBLIC_COMPANY_ADDRESS="Alamat lengkap perusahaan"
NEXT_PUBLIC_COMPANY_PHONE="0812-0000-0000"
